---
import Analytics from '@vercel/analytics/astro';
import '../styles/global.css';
import { existsSync } from 'node:fs';
import { profile, contact, initials } from '../lib/content';
import Nav from '../components/Nav.astro';

interface Props {
  title?: string;
  description?: string;
}
const { title = `${profile.name} — ${profile.role}`, description = profile.valueProposition } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
// public/og.png is generated from content.json by `npm run og`; fall back to the photo.
const hasOg = existsSync('public/og.png');
const ogImage = hasOg ? new URL('/og.png', Astro.site).href : profile.photo ? new URL(profile.photo, Astro.site).href : null;
const favicon = `data:image/svg+xml,${encodeURIComponent(
  `<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' rx='8' fill='#101010'/><rect x='1' y='1' width='30' height='30' rx='7' fill='none' stroke='#00d992' stroke-width='2'/><text x='16' y='21.5' text-anchor='middle' font-family='Arial,sans-serif' font-size='14' font-weight='700' fill='#00d992'>${initials}</text></svg>`,
)}`;
const site = Astro.site ? new URL('/', Astro.site).href : undefined;
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  jobTitle: profile.role,
  description: profile.valueProposition,
  url: site,
  image: profile.photo && site ? new URL(profile.photo, site).href : undefined,
  sameAs: contact.linkedin ? [contact.linkedin] : undefined,
  alumniOf: profile.education ? { '@type': 'CollegeOrUniversity', name: profile.education.school } : undefined,
  address: profile.location ? { '@type': 'PostalAddress', addressLocality: profile.location } : undefined,
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#101010" />
    <script is:inline>document.documentElement.classList.add('js')</script>
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {hasOg && <meta property="og:image:width" content="1200" />}
    {hasOg && <meta property="og:image:height" content="630" />}
    {ogImage && <meta property="og:image:alt" content={`${profile.name} — ${profile.role}`} />}
    <meta name="twitter:card" content={hasOg ? 'summary_large_image' : 'summary'} />
    <link rel="icon" href={favicon} />
    <script type="application/ld+json" set:html={JSON.stringify(person)} />
  </head>
  <body>
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[500] btn btn-primary">Skip to content</a>
    <Nav />
    <main id="main"><slot /></main>
    <Analytics />
    <script>
      import { track } from '@vercel/analytics';
      // Any element with data-event="<name>" sends that event on click (R8).
      document.addEventListener('click', (e) => {
        const el = (e.target as Element).closest<HTMLElement>('[data-event]');
        if (el?.dataset.event) track(el.dataset.event);
      });

      const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;

      // Scroll reveal: [data-reveal] gets .is-in once it enters the viewport.
      const revealIo = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (!e.isIntersecting) continue;
            e.target.classList.add('is-in');
            revealIo.unobserve(e.target);
          }
        },
        { rootMargin: '0px 0px -4% 0px' },
      );
      document.querySelectorAll('[data-reveal]').forEach((el) => revealIo.observe(el));

      // Nav: mark the section in view, close the mobile menu after a jump.
      const navLinks = document.querySelectorAll<HTMLAnchorElement>('[data-nav] a[href^="/#"]');
      const navIo = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (!e.isIntersecting) continue;
            navLinks.forEach((a) => (a.hash === `#${e.target.id}` ? a.setAttribute('aria-current', 'true') : a.removeAttribute('aria-current')));
          }
        },
        { rootMargin: '-45% 0px -50% 0px' },
      );
      document.querySelectorAll('main section[id]').forEach((s) => navIo.observe(s));
      document.querySelector('[data-nav] details')?.addEventListener('click', (e) => {
        if ((e.target as Element).closest('a')) (e.currentTarget as HTMLDetailsElement).open = false;
      });

      // 3D tilt + spotlight on cards and hero parallax: mouse/trackpad only.
      if (!reduceMotion && matchMedia('(hover: hover) and (pointer: fine)').matches) {
        const MAX_DEG = 4;
        for (const el of document.querySelectorAll<HTMLElement>('[data-tilt]')) {
          el.addEventListener('pointermove', (e) => {
            const r = el.getBoundingClientRect();
            const x = (e.clientX - r.left) / r.width;
            const y = (e.clientY - r.top) / r.height;
            el.style.setProperty('--ry', `${(x - 0.5) * MAX_DEG}deg`);
            el.style.setProperty('--rx', `${-(y - 0.5) * MAX_DEG}deg`);
            el.style.setProperty('--mx', `${x * 100}%`);
            el.style.setProperty('--my', `${y * 100}%`);
          });
          el.addEventListener('pointerleave', () => {
            el.style.removeProperty('--rx');
            el.style.removeProperty('--ry');
          });
        }
        const hero = document.querySelector<HTMLElement>('[data-parallax]');
        hero?.addEventListener('pointermove', (e) => {
          const r = hero.getBoundingClientRect();
          hero.style.setProperty('--px', ((e.clientX - r.left) / r.width - 0.5).toFixed(3));
          hero.style.setProperty('--py', ((e.clientY - r.top) / r.height - 0.5).toFixed(3));
        });
        hero?.addEventListener('pointerleave', () => {
          hero.style.removeProperty('--px');
          hero.style.removeProperty('--py');
        });
      }
    </script>
  </body>
</html>
